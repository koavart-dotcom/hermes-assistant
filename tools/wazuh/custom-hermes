#!/var/ossec/framework/python/bin/python3
# Wazuh → Hermes Assistant Server: custom integration for the Wazuh manager.
#
# Install on the manager (docs/WAZUH.md):
#   cp custom-hermes /var/ossec/integrations/
#   chown root:wazuh /var/ossec/integrations/custom-hermes
#   chmod 750 /var/ossec/integrations/custom-hermes
# and add to /var/ossec/etc/ossec.conf (values from `hermesctl wazuh-integration`):
#   <integration>
#     <name>custom-hermes</name>
#     <hook_url>http://<hermes-server>:8646/wazuh/v1/alerts</hook_url>
#     <api_key>…ingest token…</api_key>
#     <level>10</level>
#     <alert_format>json</alert_format>
#   </integration>
#
# integratord runs: custom-hermes <alert_file> <api_key> <hook_url> [...]
# Standard library only; errors go to /var/ossec/logs/integrations.log.
import json
import sys
import time
import urllib.error
import urllib.request

LOG = "/var/ossec/logs/integrations.log"


def log(msg):
    line = time.strftime("%Y/%m/%d %H:%M:%S") + " custom-hermes: " + msg + "\n"
    try:
        with open(LOG, "a") as f:
            f.write(line)
    except OSError:
        sys.stderr.write(line)


def main(argv):
    if len(argv) < 4:
        log("usage: custom-hermes <alert_file> <api_key> <hook_url>")
        return 2
    alert_file, api_key, hook_url = argv[1], argv[2], argv[3]
    try:
        with open(alert_file) as f:
            alert = json.load(f)
    except (OSError, ValueError) as e:
        log("cannot read %s: %s" % (alert_file, e))
        return 1
    body = json.dumps(alert).encode("utf-8")
    req = urllib.request.Request(
        hook_url,
        data=body,
        method="POST",
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + api_key},
    )
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                resp.read()
            return 0
        except urllib.error.HTTPError as e:
            # 4xx: wrong token / address / body — retrying will not help.
            log("HTTP %s from %s (alert %s)" % (e.code, hook_url, alert.get("id", "?")))
            if 400 <= e.code < 500:
                return 1
        except (urllib.error.URLError, OSError) as e:
            log("send failed (%d/3): %s" % (attempt + 1, e))
        time.sleep(2 * (attempt + 1))
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
